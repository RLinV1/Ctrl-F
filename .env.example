# Copy to .env and fill in. Never commit .env.
# Local setup: Postgres and SeaweedFS run in Docker on the desktop.
# Use the desktop's LAN IP (not localhost) for URLs the Pi uses.

# --- Desktop service ---
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# British voice. dev-test/tts_test.py defaults to George (JBFqnCBsd6RMkjVDRZzb) if unset.
ELEVENLABS_VOICE_ID=
DATABASE_URL=postgresql://ctrlf:ctrlf@localhost:5432/ctrlf
# Local SeaweedFS: http://localhost:8333. Real AWS S3: leave S3_ENDPOINT empty and set S3_REGION.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=ctrl-f
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# AWS S3 instead of SeaweedFS: leave S3_ENDPOINT empty, set S3_REGION (default us-east-1)
S3_REGION=
# Path to the trained weights, e.g. ./models/2026-11-02-v1/best.pt
YOLO_WEIGHTS_PATH=

# Roboflow Universe dataset downloads (training/fetch_roboflow.py); a free key from your Roboflow account settings
ROBOFLOW_API_KEY=
# --- Pi relay ---
# Where the Pi polls for jobs (the Next.js dev server on the desktop)
WEB_BASE_URL=http://192.168.1.20:3000
# Bearer token the Pi sends to /api/jobs/next
PI_JOB_TOKEN=
# Where the Pi forwards photos (the desktop service)
DESKTOP_BASE_URL=http://192.168.1.20:9000

# --- Web (Next.js) ---
# Single-user login for the UI (optional while local)
UI_PASSWORD=
# The web app also needs DATABASE_URL, S3_* and PI_JOB_TOKEN above.
