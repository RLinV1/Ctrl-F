# Copy to .env and fill in. Never commit .env.
# Local setup: Postgres and SeaweedFS run in Docker on the desktop.
# Pi uses S3 only; its actual deployment config is ~/.ctrlf.env.

# --- Desktop service ---
GEMINI_API_KEY=
# Optional; default gemini-flash-lite-latest
GEMINI_MODEL=
# Required on web for browser STT/TTS, and on desktop for S3 Pi STT.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DATABASE_URL=postgresql://ctrlf:ctrlf@localhost:5432/ctrlf
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=ctrl-f
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional legacy training tools only; the Hermes search worker does not load weights.
YOLO_WEIGHTS_PATH=

# --- Hermes Agent (desktop client; see desktop/README.md) ---
# Base URL of the running Hermes API, including /v1; remote servers require HTTPS.
HERMES_BASE_URL=http://127.0.0.1:8642/v1
# Same secret as API_SERVER_KEY in the Hermes server env; never expose to the browser.
HERMES_API_KEY=
# Agent-facing identifier; configure the actual vision provider/model inside Hermes.
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_SECONDS=30
# On the Hermes host only: SELECT-only DB connection for the memory MCP subprocess.
MEMORY_DATABASE_URL=

# --- Legacy HTTP device intake compatibility (web only; not required on Pi) ---
PI_JOB_TOKEN=

# --- Web (Next.js) ---
# Single-user login for the UI (optional while local)
UI_PASSWORD=
# The web app also needs DATABASE_URL, S3_* and PI_JOB_TOKEN above.
# S3 endpoint the browser can reach, used in signed URLs (defaults to S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=

# Logitech ALSA device from arecord -l; use a stable card name.
PI_AUDIO_DEVICE=
PI_RECORD_MAX_SECONDS=15
CAPTURE_BUTTON_PIN=5
# Optional private persistent local queue; defaults to ~/.local/state/ctrlf/requests
PI_SPOOL_DIR=
